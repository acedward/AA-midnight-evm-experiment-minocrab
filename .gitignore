generated/
generated-*/

# structured reference parameters (the Midnight SRS — hundreds of MiB)
zk-params/
bls_midnight_2p*

# key material and IR artifacts, wherever they land
*.prover
*.verifier
*.zkir
*.bzkir

# proofs and measurement scratch
*.proof

.DS_Store
